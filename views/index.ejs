<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Ez ki volt
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <table>
        <% data.forEach(element=> {
            %> <tr>
                <td>
                    <%= element.id %>
                </td>
                <td>
                    <%= element.priority %>
                </td>
                <td>
                    <%= element.mac %>
                </td>
                <td class="<%= element.enabled?"":" kikapcsolt" %>">
                    <%= element.enabled %>
                </td>
            </tr>
            <% }); %>
    </table>
</body>

</html>