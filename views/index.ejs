<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        Ez ki volt
    </title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <form action="index" method="post">
        <label for="priority">Priority</label>
        <input type="number" name="priority"><br>

        <label for="mac">Mac</label>
        <input type="text" name="mac"><br>

        <label name="enabled" for="enabled">Enabled</label>
        <input name="enabled" type="checkbox"><br>
        <button type="submit">Elküld </button>

    </form>

    <p>
        <%= locals.success?"Sikeres feltöltés":locals.errorMessage %>
    </p>

    <table>
        <% data.forEach(element=> {
            %> <tr>
                <td>
                    <%= element.id %>
                </td>
                <td>
                    <%= element.priority %>
                </td>
                <td>
                    <%= element.mac %>
                </td>
                <td class="<%= element.enabled?"":" kikapcsolt" %>">
                    <%= element.enabled %>
                </td>
            </tr>
            <% }); %>
    </table>
</body>

</html>